@model Mvc.Models.Clinic.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<style>
    /* Sky Glassmorphism Main Card */
    .details-glass-card {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(186, 230, 253, 0.8);
        border-radius: 28px;
        box-shadow: 0 20px 40px rgba(0, 119, 182, 0.08);
        overflow: hidden;
    }

    /* Card Header Overlay */
    .details-header-bg {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        padding: 2.5rem 1.5rem;
        box-shadow: 0 10px 20px rgba(2, 132, 199, 0.2);
    }

    .icon-header-glow {
        width: 70px;
        height: 70px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }

    /* Information Blocks */
    .info-card-box {
        background: rgba(224, 242, 254, 0.4);
        border: 1px solid rgba(186, 230, 253, 0.7);
        border-radius: 18px;
        padding: 1.2rem;
        transition: all 0.3s ease;
    }

        .info-card-box:hover {
            background: rgba(224, 242, 254, 0.7);
            border-color: #38bdf8;
        }

    /* Status Badges */
    .badge-status-lg {
        padding: 8px 18px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.95rem;
    }

    .badge-pending {
        background: rgba(251, 191, 36, 0.2);
        color: #b45309;
        border: 1px solid #f59e0b;
    }

    .badge-approved {
        background: rgba(52, 211, 153, 0.2);
        color: #047857;
        border: 1px solid #10b981;
    }

    .badge-other {
        background: rgba(248, 113, 113, 0.2);
        color: #b91c1c;
        border: 1px solid #ef4444;
    }

    /* Custom Buttons */
    .btn-sky-action {
        border-radius: 16px;
        padding: 12px 20px;
        font-weight: 700;
        transition: all 0.3s ease;
    }

    .btn-sky-primary {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        border: none;
        box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
    }

        .btn-sky-primary:hover {
            background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(2, 132, 199, 0.45);
        }

    .btn-sky-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #ffffff;
        border: none;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.25);
    }

        .btn-sky-success:hover {
            background: linear-gradient(135deg, #34d399 0%, #047857 100%);
            color: #ffffff;
            transform: translateY(-2px);
        }

    .btn-sky-outline {
        background: rgba(255, 255, 255, 0.6);
        color: #0284c7;
        border: 2px solid #38bdf8;
    }

        .btn-sky-outline:hover {
            background: rgba(56, 189, 248, 0.15);
            color: #0369a1;
            border-color: #0284c7;
        }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="details-glass-card">

                <!-- Header -->
                <div class="details-header-bg text-center">
                    <div class="icon-header-glow">
                        <i class="bi bi-calendar-check fs-2 text-white"></i>
                    </div>
                    <h2 class="fw-bold mb-1">Appointment Details</h2>
                    <p class="text-white-50 mb-0">Overview and patient consultation status</p>
                </div>

                <!-- Body Content -->
                <div class="card-body p-4 p-md-5">

                    <!-- Patient Section -->
                    <div class="d-flex align-items-center gap-3 mb-4 p-3 rounded-4" style="background: rgba(2, 132, 199, 0.06); border: 1px solid rgba(186, 230, 253, 0.6);">
                        <div class="p-3 rounded-circle bg-white text-primary shadow-sm">
                            <i class="bi bi-person-fill fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Patient Name</span>
                            <h4 class="fw-bold text-dark mb-0">
                                @Model.Patient.User.FullName
                            </h4>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <!-- Date Box -->
                        <div class="col-md-6">
                            <div class="info-card-box d-flex align-items-center gap-3">
                                <div class="p-2 rounded-3 bg-white text-primary shadow-sm">
                                    <i class="bi bi-calendar3 fs-5"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block fw-semibold">Date</small>
                                    <span class="fw-bold text-dark">@Model.Date.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                        </div>

                        <!-- Time Box -->
                        <div class="col-md-6">
                            <div class="info-card-box d-flex align-items-center gap-3">
                                <div class="p-2 rounded-3 bg-white text-primary shadow-sm">
                                    <i class="bi bi-clock fs-5"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block fw-semibold">Time</small>
                                    <span class="fw-bold text-dark">@Model.Time</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Status Display -->
                    <div class="d-flex align-items-center justify-content-between p-3 rounded-4 mb-4" style="background: rgba(255, 255, 255, 0.6); border: 1px solid rgba(186, 230, 253, 0.6);">
                        <span class="fw-bold text-secondary">Appointment Status</span>
                        <div>
                            @if (Model.Status == "Pending")
                            {
                                <span class="badge-status-lg badge-pending d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-hourglass-split"></i> Pending
                                </span>
                            }
                            else if (Model.Status == "Approved")
                            {
                                <span class="badge-status-lg badge-approved d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-check-circle-fill"></i> Approved
                                </span>
                            }
                            else
                            {
                                <span class="badge-status-lg badge-other d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-x-circle-fill"></i> @Model.Status
                                </span>
                            }
                        </div>
                    </div>

                    <hr class="my-4" style="border-color: rgba(186, 230, 253, 0.7);" />

                    <!-- Actions -->
                    @if (Model.Status == "Pending")
                    {
                        <div class="d-flex flex-column flex-sm-row gap-3 mb-3">
                            <form action="/Doctor/ApproveAppointment/@Model.AppointmentId" method="post" class="flex-fill">
                                <button type="submit" class="btn btn-sky-success btn-sky-action w-100 d-flex align-items-center justify-content-center">
                                    <i class="bi bi-check-lg fs-5 me-2"></i> Approve
                                </button>
                            </form>

                            <form action="/Doctor/CancelAppointment/@Model.AppointmentId" method="post" class="flex-fill">
                                <button type="submit" class="btn btn-outline-danger btn-sky-action w-100 d-flex align-items-center justify-content-center">
                                    <i class="bi bi-x-lg fs-5 me-2"></i> Cancel
                                </button>
                            </form>
                        </div>
                    }

                    @if (Model.Status == "Approved")
                    {
                        <div class="mb-3">
                            @if (Model.MedicalRecord == null)
                            {
                                <a href="/Doctor/CreateMedicalRecord/@Model.AppointmentId" class="btn btn-sky-primary btn-sky-action w-100 d-flex align-items-center justify-content-center">
                                    <i class="bi bi-file-earmark-plus fs-5 me-2"></i> Add Medical Record
                                </a>
                            }
                            else
                            {
                                <a href="/Doctor/MedicalRecord/@Model.AppointmentId" class="btn btn-sky-success btn-sky-action w-100 d-flex align-items-center justify-content-center">
                                    <i class="bi bi-file-earmark-medical fs-5 me-2"></i> View Medical Record
                                </a>
                            }
                        </div>
                    }

                    <!-- Back Button -->
                    <div class="text-center mt-4">
                        <a href="/Doctor/Index" class="btn btn-sky-outline btn-sky-action px-4 d-inline-flex align-items-center">
                            <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
                        </a>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>