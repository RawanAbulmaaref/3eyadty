@model Mvc.Models.Clinic.MedicalRecord

@{
    ViewData["Title"] = "Medical Record";
}

<style>
    /* Sky Glassmorphism Main Card */
    .record-glass-card {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(186, 230, 253, 0.8);
        border-radius: 28px;
        box-shadow: 0 20px 40px rgba(0, 119, 182, 0.08);
        overflow: hidden;
    }

    /* Success Sky Header */
    .record-header-bg {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #ffffff;
        padding: 2.5rem 1.5rem;
        box-shadow: 0 10px 20px rgba(16, 185, 129, 0.2);
    }

    .icon-header-glow {
        width: 70px;
        height: 70px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.8rem;
    }

    /* Content Cards */
    .section-card-box {
        background: rgba(224, 242, 254, 0.35);
        border: 1px solid rgba(186, 230, 253, 0.7);
        border-radius: 18px;
        padding: 1.25rem 1.5rem;
        transition: all 0.3s ease;
    }

        .section-card-box:hover {
            background: rgba(224, 242, 254, 0.65);
            border-color: #38bdf8;
        }

    .section-title {
        color: #0369a1;
        font-weight: 700;
        font-size: 0.95rem;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .section-content {
        color: #1e293b;
        font-size: 1rem;
        line-height: 1.6;
        white-space: pre-line;
    }

    /* Buttons */
    .btn-sky-action {
        border-radius: 16px;
        padding: 12px 24px;
        font-weight: 700;
        transition: all 0.3s ease;
    }

    .btn-sky-outline {
        background: rgba(255, 255, 255, 0.6);
        color: #0284c7;
        border: 2px solid #38bdf8;
    }

        .btn-sky-outline:hover {
            background: rgba(56, 189, 248, 0.15);
            color: #0369a1;
            border-color: #0284c7;
        }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="record-glass-card">

                <!-- Header -->
                <div class="record-header-bg text-center">
                    <div class="icon-header-glow">
                        <i class="bi bi-file-earmark-medical-fill fs-2 text-white"></i>
                    </div>
                    <h2 class="fw-bold mb-1">Medical Record</h2>
                    <p class="text-white-50 mb-0">Saved consultation report</p>
                </div>

                <!-- Body Content -->
                <div class="card-body p-4 p-md-5">

                    <!-- Patient Info Banner -->
                    <div class="d-flex align-items-center justify-content-between p-3 rounded-4 mb-4" style="background: rgba(2, 132, 199, 0.06); border: 1px solid rgba(186, 230, 253, 0.6);">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-3 rounded-circle bg-white text-primary shadow-sm">
                                <i class="bi bi-person-fill fs-3"></i>
                            </div>
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Patient Name</span>
                                <h4 class="fw-bold text-dark mb-0">
                                    @Model.Appointment.Patient.User.FullName
                                </h4>
                            </div>
                        </div>
                        <div class="text-end d-none d-sm-block">
                            <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold border shadow-sm">
                                <i class="bi bi-calendar3 me-1"></i> @Model.Date.ToString("dd MMM yyyy")
                            </span>
                        </div>
                    </div>

                    <!-- Date Block for Small Screens -->
                    <div class="d-block d-sm-none mb-4">
                        <div class="section-card-box">
                            <div class="section-title">
                                <i class="bi bi-calendar3 fs-5"></i> Date
                            </div>
                            <div class="section-content fw-bold">
                                @Model.Date.ToString("dd MMM yyyy")
                            </div>
                        </div>
                    </div>

                    <!-- Details Sections -->
                    <div class="d-flex flex-column gap-3 mb-4">

                        <!-- Diagnosis -->
                        <div class="section-card-box">
                            <div class="section-title">
                                <i class="bi bi-activity fs-5"></i> Diagnosis
                            </div>
                            <div class="section-content fw-semibold">
                                @Model.Diagnosis
                            </div>
                        </div>

                        <!-- Prescription -->
                        <div class="section-card-box">
                            <div class="section-title">
                                <i class="bi bi-capsule fs-5"></i> Prescription
                            </div>
                            <div class="section-content @(string.IsNullOrEmpty(Model.Prescription) ? "text-muted opacity-75 fw-normal" : "")">
                                @(string.IsNullOrEmpty(Model.Prescription)
                                    ? "No prescription provided."
                                    : Model.Prescription)
                            </div>
                        </div>

                        <!-- Notes -->
                        <div class="section-card-box">
                            <div class="section-title">
                                <i class="bi bi-journal-text fs-5"></i> Clinical Notes
                            </div>
                            <div class="section-content @(string.IsNullOrEmpty(Model.Note) ? "text-muted opacity-75 fw-normal" : "")">
                                @(string.IsNullOrEmpty(Model.Note)
                                    ? "No additional notes recorded."
                                    : Model.Note)
                            </div>
                        </div>

                    </div>

                    <!-- Back Action -->
                    <div class="text-center pt-3">
                        <a href="/Doctor/AppointmentDetails/@Model.AppointmentId" class="btn btn-sky-outline btn-sky-action d-inline-flex align-items-center">
                            <i class="bi bi-arrow-left me-2"></i> Back to Appointment
                        </a>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>