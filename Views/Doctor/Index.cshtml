@model List<Mvc.Models.Clinic.Appointment>

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<style>
    /* Gradient Background & Header Glow */
    .dashboard-header {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(224, 242, 254, 0.8) 100%);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(186, 230, 253, 0.8);
        border-radius: 24px;
        padding: 2rem;
        box-shadow: 0 10px 30px rgba(0, 119, 182, 0.08);
    }

    .doctor-avatar-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        box-shadow: 0 8px 20px rgba(2, 132, 199, 0.25);
    }

    /* Sky Glassmorphism Appointment Cards */
    .appointment-card {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(186, 230, 253, 0.7);
        border-radius: 24px;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 10px 25px rgba(0, 119, 182, 0.05);
    }

        .appointment-card:hover {
            transform: translateY(-8px);
            border-color: #38bdf8;
            box-shadow: 0 20px 35px rgba(2, 132, 199, 0.18);
        }

    /* Section Styling */
    .patient-name {
        color: #0f172a;
        font-size: 1.2rem;
    }

    .info-pill {
        background: rgba(224, 242, 254, 0.5);
        border: 1px solid rgba(186, 230, 253, 0.6);
        border-radius: 14px;
        padding: 10px 14px;
        color: #0369a1;
        font-weight: 600;
        font-size: 0.92rem;
    }

    /* Action Buttons */
    .btn-sky-action {
        border-radius: 14px;
        padding: 10px 16px;
        font-weight: 700;
        transition: all 0.25s ease;
    }

    .btn-sky-primary {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        border: none;
        box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
    }

        .btn-sky-primary:hover {
            background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(2, 132, 199, 0.45);
        }

    .btn-sky-outline {
        background: transparent;
        color: #0284c7;
        border: 2px solid #38bdf8;
    }

        .btn-sky-outline:hover {
            background: rgba(56, 189, 248, 0.12);
            color: #0369a1;
            border-color: #0284c7;
        }

    .btn-sky-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #ffffff;
        border: none;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.25);
    }

        .btn-sky-success:hover {
            background: linear-gradient(135deg, #34d399 0%, #047857 100%);
            color: #ffffff;
            transform: translateY(-2px);
        }

    /* Custom Badges */
    .badge-status {
        padding: 8px 16px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.3px;
    }

    .badge-pending {
        background: rgba(251, 191, 36, 0.18);
        color: #b45309;
        border: 1px solid #f59e0b;
    }

    .badge-approved {
        background: rgba(52, 211, 153, 0.18);
        color: #047857;
        border: 1px solid #10b981;
    }

    .badge-cancelled {
        background: rgba(248, 113, 113, 0.18);
        color: #b91c1c;
        border: 1px solid #ef4444;
    }

    .badge-default {
        background: rgba(148, 163, 184, 0.18);
        color: #475569;
        border: 1px solid #94a3b8;
    }

    /* Empty State Card */
    .empty-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(15px);
        border: 2px dashed #bae6fd;
        border-radius: 28px;
    }
</style>

<div class="container py-5">

    <!-- Welcome Section -->
    <div class="dashboard-header mb-5">
        <div class="d-flex align-items-center gap-4">
            <div class="doctor-avatar-icon">
                <i class="bi bi-person-badge"></i>
            </div>
            <div>
                <h2 class="fw-extrabold mb-1" style="color: #0f172a;">
                    Hello, Dr. @ViewBag.DoctorName 👋
                </h2>
                <p class="text-secondary mb-0 fw-medium">
                    Welcome to your medical dashboard. Here is your schedule overview.
                </p>
            </div>
        </div>
    </div>

    <!-- Section Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h4 class="fw-bold mb-0 d-flex align-items-center gap-2" style="color: #0c4a6e;">
            <i class="bi bi-calendar2-week text-primary"></i> My Appointments
        </h4>
        @if (Model != null && Model.Any())
        {
            <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">
                Total: @Model.Count
            </span>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Empty State -->
        <div class="empty-card text-center p-5 my-4">
            <div class="d-inline-flex p-4 rounded-circle mb-3" style="background: rgba(224, 242, 254, 0.8); color: #0284c7;">
                <i class="bi bi-calendar-x display-4"></i>
            </div>
            <h4 class="fw-bold text-dark mt-2">No Appointments Scheduled</h4>
            <p class="text-secondary mb-0">You don't have any patient bookings assigned yet.</p>
        </div>
    }
    else
    {
        <!-- Appointments Grid -->
        <div class="row g-4">
            @foreach (var appointment in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="appointment-card h-100 p-4 d-flex flex-column justify-content-between">
                        <div>
                            <!-- Header: Patient Name & Status -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="p-2 rounded-circle" style="background: rgba(2, 132, 199, 0.1); color: #0284c7;">
                                        <i class="bi bi-person-fill fs-5"></i>
                                    </div>
                                    <h5 class="fw-bold patient-name mb-0">
                                        @appointment.Patient.User.FullName
                                    </h5>
                                </div>
                            </div>

                            <div class="mb-3">
                                @if (appointment.Status == "Pending")
                                {
                                    <span class="badge-status badge-pending d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-hourglass-split"></i> Pending
                                    </span>
                                }
                                else if (appointment.Status == "Approved")
                                {
                                    <span class="badge-status badge-approved d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-check-circle-fill"></i> Approved
                                    </span>
                                }
                                else if (appointment.Status == "Cancelled")
                                {
                                    <span class="badge-status badge-cancelled d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-x-circle-fill"></i> Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status badge-default">
                                        @appointment.Status
                                    </span>
                                }
                            </div>

                            <hr style="border-color: rgba(186, 230, 253, 0.6);" />

                            <!-- Date & Time Info Pills -->
                            <div class="d-flex flex-column gap-2 mb-4">
                                <div class="info-pill d-flex align-items-center">
                                    <i class="bi bi-calendar3 me-2 fs-6"></i>
                                    <span>@appointment.Date.ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="info-pill d-flex align-items-center">
                                    <i class="bi bi-clock me-2 fs-6"></i>
                                    <span>@appointment.Time</span>
                                </div>
                            </div>
                        </div>

                        <!-- Actions Area -->
                        <div class="d-grid gap-2">
                            <!-- Details Button -->
                            <a href="/Doctor/AppointmentDetails/@appointment.AppointmentId"
                               class="btn btn-sky-outline btn-sky-action w-100 d-flex align-items-center justify-content-center">
                                <i class="bi bi-eye me-2"></i> View Details
                            </a>

                            <!-- Pending State Actions -->
                            @if (appointment.Status == "Pending")
                            {
                                <form action="/Doctor/ApproveAppointment/@appointment.AppointmentId" method="post" class="m-0">
                                    <button type="submit" class="btn btn-sky-success btn-sky-action w-100 d-flex align-items-center justify-content-center">
                                        <i class="bi bi-check-lg me-2"></i> Approve
                                    </button>
                                </form>

                                <form action="/Doctor/CancelAppointment/@appointment.AppointmentId" method="post" class="m-0">
                                    <button type="submit" class="btn btn-outline-danger btn-sky-action w-100 d-flex align-items-center justify-content-center">
                                        <i class="bi bi-x-lg me-2"></i> Cancel
                                    </button>
                                </form>
                            }

                            <!-- Approved State Actions -->
                            @if (appointment.Status == "Approved")
                            {
                                @if (appointment.MedicalRecord == null)
                                {
                                    <a href="/Doctor/CreateMedicalRecord/@appointment.AppointmentId"
                                       class="btn btn-sky-primary btn-sky-action w-100 d-flex align-items-center justify-content-center">
                                        <i class="bi bi-file-earmark-plus me-2"></i> Add Medical Record
                                    </a>
                                }
                                else
                                {
                                    <a href="/Doctor/MedicalRecord/@appointment.AppointmentId"
                                       class="btn btn-sky-success btn-sky-action w-100 d-flex align-items-center justify-content-center">
                                        <i class="bi bi-file-earmark-medical me-2"></i> View Medical Record
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>