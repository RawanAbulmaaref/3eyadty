@model List<Mvc.Models.Clinic.Appointment>

@{
    ViewData["Title"] = "Patient Dashboard";
}

<style>

    .dashboard-header-card {
        background: linear-gradient(135deg, rgba(2, 132, 199, 0.9) 0%, rgba(3, 105, 161, 0.95) 100%);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 24px;
        box-shadow: 0 15px 35px rgba(2, 132, 199, 0.2);
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(186, 230, 253, 0.7);
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 119, 182, 0.05);
        transition: all 0.3s ease;
    }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 40px rgba(2, 132, 199, 0.12);
            border-color: rgba(56, 189, 248, 0.8);
        }

    .sky-badge {
        padding: 6px 14px;
        border-radius: 50rem;
        font-weight: 600;
        font-size: 0.8rem;
        letter-spacing: 0.3px;
    }

    .badge-pending {
        background-color: rgba(254, 240, 138, 0.8);
        color: #854d0e;
        border: 1px solid #fef08a;
    }

    .badge-approved {
        background-color: rgba(187, 247, 208, 0.8);
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .badge-cancelled {
        background-color: rgba(254, 202, 202, 0.8);
        color: #991b1b;
        border: 1px solid #fca5a5;
    }

    .info-pill {
        background: rgba(240, 249, 255, 0.8);
        border-radius: 12px;
        padding: 8px 14px;
        font-weight: 500;
        color: #0369a1;
        font-size: 0.9rem;
    }

    .btn-sky-light {
        background: rgba(255, 255, 255, 0.2);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(8px);
        border-radius: 14px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-sky-light:hover {
            background: #ffffff;
            color: #0284c7;
            transform: translateY(-2px);
        }

    .btn-sky-action {
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.88rem;
        transition: all 0.2s ease;
    }

    .glass-modal {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        border: 1px solid rgba(186, 230, 253, 0.8);
    }

</style>


<div class="container py-5">

    <!-- ================= HEADER ================= -->

    <div class="dashboard-header-card p-4 p-md-5 mb-5 text-white">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

            <div>

                <span class="badge bg-white text-primary rounded-pill px-3 py-2 mb-2 fw-bold shadow-sm">

                    <i class="bi bi-heart-pulse-fill text-danger me-1"></i>

                    Patient Portal

                </span>

                <h1 class="fw-bold mb-1 display-6">

                    Hello, @(ViewBag.PatientName ?? "Patient")

                </h1>

                <p class="text-white-50 mb-0 fs-5">

                    Welcome to your dashboard.

                </p>

            </div>


            <!-- ================= BOOK APPOINTMENT ================= -->

            <div>

                <a href="/Patient/Book"
                   class="btn btn-sky-light btn-lg px-4 py-3">

                    <i class="bi bi-calendar-plus me-2"></i>

                    Book Appointment

                </a>

            </div>

        </div>

    </div>


    <!-- ================= SECTION HEADER ================= -->

    <div class="d-flex align-items-center justify-content-between mb-4">

        <h4 class="fw-bold mb-0">

            <i class="bi bi-calendar2-week text-primary me-2"></i>

            My Appointments

        </h4>


        @if (Model != null && Model.Any())
        {
            <span class="badge bg-primary rounded-pill fs-6 px-3">

                @Model.Count

            </span>
        }

    </div>


    <!-- ================= NO APPOINTMENTS ================= -->
    @if (Model == null || !Model.Any())
    {
        <div class="glass-card text-center p-5">

            <i class="bi bi-calendar-x text-primary display-1 opacity-50"></i>

            <h4 class="fw-bold mt-3">

                No Appointments Found

            </h4>

            <p class="text-muted">

                You haven't scheduled any appointments yet.

            </p>


            <a href="/Patient/Book"
               class="btn btn-primary btn-lg rounded-3 px-4">

                <i class="bi bi-calendar-plus me-2"></i>

                Book Your First Appointment

            </a>

        </div>
    }

    else
    {

        <!-- ================= APPOINTMENTS ================= -->

        <div class="row g-4">

            @foreach (var appointment in Model)
            {

                <div class="col-md-6 col-lg-4">

                    <div class="glass-card h-100 p-4 d-flex flex-column justify-content-between">

                        <div>

                            <!-- DOCTOR + STATUS -->

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <div class="d-flex align-items-center gap-3">

                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center"
                                         style="width:48px;height:48px;">

                                        <i class="bi bi-person-badge fs-4"></i>

                                    </div>


                                    <div>

                                        <h6 class="fw-bold mb-0">

                                            Dr.
                                            @(appointment.Doctor?.User?.FullName
                                                ?? "Unknown Doctor")

                                        </h6>


                                        <small class="text-primary">

                                            @(appointment.Doctor?.Specialization
                                                ?? "General")

                                        </small>

                                    </div>

                                </div>


                                <!-- STATUS -->
                                @if (appointment.Status == "Pending")
                                {
                                    <span class="sky-badge badge-pending">

                                        <i class="bi bi-hourglass-split me-1"></i>

                                        Pending

                                    </span>
                                }
                                else if (appointment.Status == "Approved")
                                {
                                    <span class="sky-badge badge-approved">

                                        <i class="bi bi-check-circle-fill me-1"></i>

                                        Approved

                                    </span>
                                }
                                else if (appointment.Status == "Cancelled")
                                {
                                    <span class="sky-badge badge-cancelled">

                                        <i class="bi bi-x-circle-fill me-1"></i>

                                        Cancelled

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        @appointment.Status

                                    </span>
                                }

                            </div>


                            <hr />


                            <!-- DATE -->

                            <div class="d-flex flex-column gap-2 mb-4">

                                <div class="info-pill">

                                    <i class="bi bi-calendar3 me-2"></i>

                                    @appointment.Date.ToString("dd MMMM yyyy")

                                </div>


                                <!-- TIME -->

                                <div class="info-pill">

                                    <i class="bi bi-clock me-2"></i>

                                    @appointment.Time.ToString(@"hh\:mm")

                                </div>

                            </div>

                        </div>


                        <!-- ================= ACTIONS ================= -->

                        <div class="d-grid gap-2">


                            <!-- DETAILS -->

                            <a href="/Patient/Details/@appointment.AppointmentId"
                               class="btn btn-outline-primary btn-sky-action">

                                <i class="bi bi-eye me-1"></i>

                                View Details

                            </a>


                            @if (appointment.Status == "Pending")
                            {

                                <div class="row g-2">

                                    <!-- EDIT -->

                                    <div class="col-6">

                                        <a href="/Patient/Edit/@appointment.AppointmentId"
                                           class="btn btn-outline-warning btn-sky-action w-100">

                                            <i class="bi bi-pencil me-1"></i>

                                            Edit

                                        </a>

                                    </div>


                                    <!-- DELETE -->

                                    <div class="col-6">

                                        <button type="button"
                                                class="btn btn-outline-danger btn-sky-action w-100"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal-@appointment.AppointmentId">

                                            <i class="bi bi-trash me-1"></i>

                                            Delete

                                        </button>

                                    </div>

                                </div>

                            }

                        </div>

                    </div>

                </div>


                <!-- ================= DELETE MODAL ================= -->
                @if (appointment.Status == "Pending")
                {

                    <div class="modal fade"
                         id="deleteModal-@appointment.AppointmentId"
                         tabindex="-1"
                         aria-hidden="true">

                        <div class="modal-dialog modal-dialog-centered">

                            <div class="modal-content glass-modal border-0">

                                <div class="modal-header border-0">

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal"
                                            aria-label="Close">
                                    </button>

                                </div>


                                <div class="modal-body text-center p-4">

                                    <i class="bi bi-exclamation-triangle-fill text-danger display-3"></i>

                                    <h4 class="fw-bold mt-3">

                                        Delete Appointment?

                                    </h4>

                                    <p class="text-muted">

                                        Are you sure you want to delete this appointment?

                                    </p>

                                </div>


                                <div class="modal-footer border-0 justify-content-center">

                                    <button type="button"
                                            class="btn btn-light rounded-3"
                                            data-bs-dismiss="modal">

                                        Cancel

                                    </button>


                                    <form action="/Patient/Delete/@appointment.AppointmentId"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-danger rounded-3">

                                            <i class="bi bi-trash me-1"></i>

                                            Yes, Delete

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                }

            }

        </div>

    }

</div>