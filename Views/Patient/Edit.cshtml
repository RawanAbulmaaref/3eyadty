@model Mvc.Models.Clinic.Appointment
@using Mvc.Models.Clinic

@{
    ViewData["Title"] = "Edit Appointment";

    var doctors = ViewBag.Doctors as List<Doctor>
                   ?? new List<Doctor>();
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-lg rounded-4">

                <!-- Header -->

                <div class="bg-warning text-dark text-center p-4 rounded-top-4">

                    <i class="bi bi-pencil-square fs-1"></i>

                    <h2 class="fw-bold mt-2 mb-1">
                        Edit Appointment
                    </h2>

                    <p class="mb-0">
                        Update your appointment information
                    </p>

                </div>


                <!-- Body -->

                <div class="card-body p-4 p-md-5">


                    <!-- Error -->
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger rounded-3">

                            <i class="bi bi-exclamation-circle me-2"></i>

                            @ViewBag.Error

                        </div>
                    }


                    <!-- Form -->

                    <form asp-controller="Patient"
                          asp-action="Edit"
                          asp-route-id="@Model.AppointmentId"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- Doctor -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Choose Doctor
                            </label>

                            <select name="doctorId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Doctor --
                                </option>

                                @foreach (var doctor in doctors)
                                {
                                    if (doctor.DoctorId == Model.DoctorId)
                                    {
                                        <option value="@doctor.DoctorId" selected>

                                            Dr. @(doctor.User?.FullName ?? "Unknown")
                                            - @doctor.Specialization

                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@doctor.DoctorId">

                                            Dr. @(doctor.User?.FullName ?? "Unknown")
                                            - @doctor.Specialization

                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- Date -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Date
                            </label>

                            <input type="date"
                                   name="date"
                                   class="form-control"
                                   value="@Model.Date.ToString("yyyy-MM-dd")"
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")"
                                   required />

                        </div>


                        <!-- Time -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Time
                            </label>

                            <input type="time"
                                   name="time"
                                   class="form-control"
                                   value="@Model.Time.ToString(@"hh\:mm")"
                                   required />

                        </div>


                        <!-- Save -->

                        <button type="submit"
                                class="btn btn-warning w-100 py-2 fw-semibold">

                            <i class="bi bi-check-lg me-2"></i>

                            Save Changes

                        </button>

                    </form>


                    <!-- Back -->

                    <div class="text-center mt-4">

                        <a href="/Patient"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-2"></i>

                            Back to Dashboard

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>