<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 3eyadty</title>

    <!-- Google Fonts for Creative Franco Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <style>
            :root {
                --bg-pastel: #f6f9fc;
                --primary-soft: #5b7dae;
                --primary-hover: #4a6c9d;
                --accent-soft: #eaf1f8;
                --text-dark: #2b3648;
                --text-muted: #718096;
            }

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: var(--bg-pastel);
                color: var(--text-dark);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* --- Creative Franco Logo (3eyadty) --- */
            .creative-logo {
                display: inline-flex;
                align-items: center;
                gap: 2px;
                text-decoration: none;
                font-family: 'Outfit', sans-serif;
                transition: all 0.3s ease;
            }

                .creative-logo:hover {
                    transform: translateY(-2px);
                }

            .logo-number-3 {
                width: 42px;
                height: 42px;
                background: linear-gradient(135deg, #6c8ebf 0%, #4a6c9d 100%);
                color: #ffffff;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 900;
                font-size: 1.6rem;
                box-shadow: 0 6px 16px rgba(91, 125, 174, 0.35);
                margin-right: 3px;
            }

            .logo-text-eyadt {
                font-size: 1.85rem;
                font-weight: 800;
                color: #2c3e50;
                letter-spacing: -0.5px;
            }

            .logo-text-gradient {
                background: linear-gradient(135deg, #6385af 0%, #90aed4 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                font-size: 1.9rem;
                font-weight: 900;
            }

            .logo-plus-icon {
                font-size: 0.85rem;
                color: #e76f51;
                vertical-align: super;
                margin-left: 2px;
            }

            /* --- Custom Soft Navbar --- */
            .custom-navbar {
                background: rgba(255, 255, 255, 0.88) !important;
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border-bottom: 1px solid rgba(226, 235, 244, 0.9);
                padding: 12px 0;
            }

            .nav-link {
                color: var(--text-dark) !important;
                font-weight: 600;
                padding: 8px 18px !important;
                border-radius: 12px;
                transition: all 0.2s ease;
            }

                .nav-link:hover {
                    color: var(--primary-soft) !important;
                    background-color: var(--accent-soft);
                }

            .btn-nav-accent {
                background: linear-gradient(135deg, #6c8ebf 0%, #5b7dae 100%);
                color: #ffffff !important;
                border-radius: 12px;
                padding: 8px 24px !important;
                font-weight: 600;
                transition: all 0.3s ease;
                box-shadow: 0 4px 14px rgba(91, 125, 174, 0.28);
            }

                .btn-nav-accent:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 6px 18px rgba(91, 125, 174, 0.38);
                }

            /* --- Footer --- */
            .custom-footer {
                background: #ffffff;
                border-top: 1px solid rgba(226, 235, 244, 0.8);
                margin-top: auto;
                padding: 35px 0 20px;
            }
    </style>
</head>
<body>

    <!-- Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg custom-navbar fixed-top">
            <div class="container">

                <!-- Franco Brand Logo: 3eyadty -->
                <a class="creative-logo" href="/Home/Index">
                    <span class="logo-number-3">3</span>
                    <span class="logo-text-eyadt">eyadt</span>
                    <span class="logo-text-gradient">y</span>
                    <i class="bi bi-plus-lg logo-plus-icon"></i>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav ms-auto align-items-center gap-2 mt-3 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Index"><i class="bi bi-house-door me-1"></i> Home</a>
                        </li>

                        @if (Context.Session.GetString("UserRole") != null)
                        {
                            var role = Context.Session.GetString("UserRole");
                            if (role == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/Admin/Index"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
                                </li>
                            }
                            else if (role == "Doctor")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/Doctor/Index"><i class="bi bi-person-badge me-1"></i> Doctor Panel</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/Patient/Index"><i class="bi bi-calendar-check me-1"></i> My Appointments</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-danger" href="/Account/Logout"><i class="bi bi-box-arrow-right me-1"></i> Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Account/Login"><i class="bi bi-box-arrow-in-right me-1"></i> Log In</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn-nav-accent text-white" href="/Account/SignUp"><i class="bi bi-person-plus me-1"></i> Sign Up</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main" style="padding-top: 85px;">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="custom-footer">
        <div class="container">
            <div class="row align-items-center gy-3">
                <div class="col-md-6 text-center text-md-start">
                    <a class="creative-logo" href="/Home/Index">
                        <span class="logo-number-3" style="width: 32px; height: 32px; font-size: 1.2rem;">3</span>
                        <span class="logo-text-eyadt" style="font-size: 1.4rem;">eyadt</span>
                        <span class="logo-text-gradient" style="font-size: 1.4rem;">y</span>
                    </a>
                    <p class="text-muted small mb-0 mt-1">Smart Clinic & Healthcare Management.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <p class="text-muted small mb-0">&copy; 2026 <strong>3eyadty</strong>. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>