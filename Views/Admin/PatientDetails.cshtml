@model Mvc.Models.Clinic.Patient

@{
    ViewData["Title"] = "Patient Details";
    var appointments = ViewBag.Appointments as IEnumerable<Mvc.Models.Clinic.Appointment>;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Patient Profile</h2>
            <p class="text-muted mb-0">Information and medical history for @Model.User?.FullName</p>
        </div>
        <a href="/Admin/Patients" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i> Back to Patients
        </a>
    </div>

    <div class="row g-4">
        <!-- Patient Info Card -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-person-circle display-1 text-secondary"></i>
                    </div>
                    <h4 class="fw-bold mb-1">@Model.User?.FullName</h4>
                    <p class="text-muted mb-3"><i class="bi bi-envelope me-2"></i>@Model.User?.Email</p>
                </div>
            </div>
        </div>

        <!-- Appointment History Card -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold mb-0">Appointment History</h5>
                </div>
                <div class="card-body p-0">
                    @if (appointments == null || !appointments.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x fs-1 text-muted"></i>
                            <p class="text-muted mt-2">No appointments found for this patient.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="px-4">Doctor</th>
                                        <th>Date & Time</th>
                                        <th>Status</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var app in appointments)
                                    {
                                        <tr>
                                            <td class="px-4">
                                                <div class="fw-semibold">Dr. @app.Doctor?.User?.FullName</div>
                                                <small class="text-muted">@app.Doctor?.Specialization</small>
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@app.Date.ToString("yyyy-MM-dd")</div>
                                                <small class="text-muted">@app.Time</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@app.Status</span>
                                            </td>
                                            <td class="text-center">
                                                <a href="/Admin/AppointmentDetails?id=@app.AppointmentId" class="btn btn-sm btn-outline-secondary">
                                                    View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>