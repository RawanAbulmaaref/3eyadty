@model IEnumerable<Mvc.Models.Clinic.Doctor>

@{
    ViewData["Title"] = "Doctors Management";
}

<div class="container py-5">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Doctors Management</h2>
            <p class="text-muted mb-0">View, approve, or manage all registered doctor accounts.</p>
        </div>
        <a href="/Admin/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <!-- Doctors Table Card -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold mb-0">Registered Doctors List</h5>
        </div>
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-people fs-1 text-muted"></i>
                    <p class="text-muted mt-2">No doctors registered yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4">Doctor Name</th>
                                <th>Specialization</th>
                                <th>Status</th>
                                <th>Certificate</th>
                                <th class="text-end px-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doctor in Model)
                            {
                                <tr>
                                    <td class="px-4">
                                        <div class="d-flex align-items-center">
                                            <div class="me-3">
                                                <i class="bi bi-person-circle fs-3 text-secondary"></i>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">Dr. @doctor.User?.FullName</div>
                                                <small class="text-muted">@doctor.User?.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @doctor.Specialization
                                        </span>
                                    </td>
                                    <td>
                                        @if (doctor.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (doctor.Status == "Approved")
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else if (doctor.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@doctor.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(doctor.CertificatePath))
                                        {
                                            <a href="@doctor.CertificatePath" target="_blank" class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-file-earmark-pdf me-1"></i> View
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">N/A</span>
                                        }
                                    </td>
                                    <td class="text-end px-4">
                                        <div class="btn-group" role="group">
                                            <!-- زر التفاصيل -->
                                            <a href="/Admin/DoctorDetails?id=@doctor.DoctorId" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye me-1"></i> Details
                                            </a>

                                            <!-- زر الموافقة -->
                                            @if (doctor.Status != "Approved")
                                            {
                                                <form action="/Admin/ApproveDoctor" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@doctor.DoctorId" />
                                                    <button type="submit" class="btn btn-sm btn-success rounded-0 ms-1" title="Approve">
                                                        <i class="bi bi-check-lg"></i> Approve
                                                    </button>
                                                </form>
                                            }

                                            <!-- زر الرفض -->
                                            @if (doctor.Status != "Rejected")
                                            {
                                                <button type="button" class="btn btn-sm btn-danger ms-1" data-bs-toggle="modal" data-bs-target="#rejectModal-@doctor.DoctorId" title="Reject">
                                                    <i class="bi bi-x-lg"></i> Reject
                                                </button>

                                                <!-- نافذة سبب الرفض -->
                                                <div class="modal fade text-start" id="rejectModal-@doctor.DoctorId" tabindex="-1">
                                                    <div class="modal-dialog modal-dialog-centered">
                                                        <div class="modal-content border-0 rounded-4 shadow">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title fw-bold">Reject Doctor Account</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <form action="/Admin/RejectDoctor" method="post">
                                                                <input type="hidden" name="id" value="@doctor.DoctorId" />
                                                                <div class="modal-body">
                                                                    <p class="text-muted">You are rejecting <strong>Dr. @doctor.User?.FullName</strong>.</p>
                                                                    <label class="form-label fw-semibold">Rejection Reason</label>
                                                                    <textarea name="rejectionReason" class="form-control" rows="3" placeholder="Specify reason..." required></textarea>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                    <button type="submit" class="btn btn-danger">Reject</button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>