@{
    ViewData["Title"] = "3eyadty - Smart Medical Platform";
}

<style>
    /* Hero Banner with Full Image Background & Sky Glow */
    .hero-banner {
        position: relative;
        min-height: 88vh;
        background: url('https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?q=80&w=1920&auto=format&fit=crop') center/cover no-repeat fixed;
        display: flex;
        align-items: center;
        border-radius: 0 0 45px 45px;
        overflow: hidden;
    }

    /* Soft Sky Gradient Overlay */
    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, rgba(135, 206, 235, 0.85) 0%, rgba(176, 224, 230, 0.78) 60%, rgba(224, 247, 250, 0.88) 100%);
    }

    /* Brand Titles (Dark text for high contrast on sky background) */
    .hero-brand-title {
        font-family: 'Outfit', sans-serif;
        font-weight: 900;
        font-size: 4.2rem;
        color: #0f2537;
        letter-spacing: -1px;
        text-shadow: 0 2px 10px rgba(255, 255, 255, 0.5);
    }

    .hero-number-3 {
        color: #0077b6;
        text-shadow: 0 0 15px rgba(0, 119, 182, 0.4);
        display: inline-block;
    }

    .hero-brand-gradient {
        background: linear-gradient(135deg, #0077b6 0%, #0096c7 50%, #03045e 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* Buttons */
    .btn-sky-primary {
        background: linear-gradient(135deg, #0077b6 0%, #023e8a 100%);
        color: #ffffff;
        border: none;
        padding: 16px 38px;
        border-radius: 16px;
        font-weight: 800;
        font-size: 1.1rem;
        box-shadow: 0 8px 20px rgba(0, 119, 182, 0.3);
        transition: all 0.3s ease;
    }

        .btn-sky-primary:hover {
            background: linear-gradient(135deg, #0096c7 0%, #03045e 100%);
            color: #ffffff;
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 12px 25px rgba(0, 119, 182, 0.45);
        }

    .btn-sky-secondary {
        background: rgba(255, 255, 255, 0.7);
        color: #023e8a;
        border: 2px solid #0077b6;
        padding: 14px 36px;
        border-radius: 16px;
        font-weight: 800;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        backdrop-filter: blur(8px);
    }

        .btn-sky-secondary:hover {
            background: #0077b6;
            color: #ffffff;
            transform: translateY(-3px);
        }

    /* Light Sky Glassmorphic Cards */
    .sky-glass-card {
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 28px;
        box-shadow: 0 15px 35px rgba(0, 119, 182, 0.15);
        transition: all 0.3s ease;
    }

        .sky-glass-card:hover {
            border-color: #0077b6;
            transform: translateY(-6px);
            box-shadow: 0 20px 40px rgba(0, 119, 182, 0.25);
        }

    .badge-sky {
        background: rgba(0, 119, 182, 0.12);
        border: 1px solid #0077b6;
        color: #0077b6;
        font-weight: 700;
        padding: 8px 22px;
        border-radius: 50px;
        font-size: 0.9rem;
    }

    .sky-icon-box {
        width: 65px;
        height: 65px;
        background: linear-gradient(135deg, #0077b6 0%, #00b4d8 100%);
        color: #ffffff;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        box-shadow: 0 8px 20px rgba(0, 119, 182, 0.3);
    }
</style>

<!-- Hero Section with Background Image -->
<div class="hero-banner mb-5">
    <div class="hero-overlay"></div>
    <div class="container position-relative py-5">
        <div class="row align-items-center g-5">

            <div class="col-lg-7">
                <span class="badge-sky mb-3 d-inline-block">
                    <i class="bi bi-heart-pulse-fill text-danger me-1"></i> Next-Gen Medical Platform
                </span>

                <!-- Franco Brand Title -->
                <h1 class="hero-brand-title mb-3">
                    Welcome to <span class="hero-number-3">3</span><span class="hero-brand-gradient">eyadty</span>
                </h1>

                <p class="fs-5 text-dark fw-medium mb-4 pe-lg-4" style="line-height: 1.8; opacity: 0.85;">
                    Experience healthcare with maximum speed and style. Book instant appointments, manage patient consultations, and access digital prescriptions effortlessly.
                </p>

                <!-- Dynamic Action Buttons -->
                <div class="d-flex flex-wrap gap-3 align-items-center">
                    @if (Context.Session.GetString("UserRole") != null)
                    {
                        var role = Context.Session.GetString("UserRole");
                        if (role == "Admin")
                        {
                            <a href="/Admin/Index" class="btn btn-sky-primary">
                                <i class="bi bi-speedometer2 me-2"></i> Dashboard
                            </a>
                        }
                        else if (role == "Doctor")
                        {
                            <a href="/Doctor/Index" class="btn btn-sky-primary">
                                <i class="bi bi-person-badge me-2"></i> Doctor Panel
                            </a>
                        }
                        else
                        {
                            <a href="/Patient/Index" class="btn btn-sky-primary">
                                <i class="bi bi-calendar-check me-2"></i> Book Appointment
                            </a>
                        }
                    }
                    else
                    {
                        <a href="/Account/SignUp" class="btn btn-sky-primary">
                            <i class="bi bi-person-plus me-2"></i> Get Started
                        </a>
                        <a href="/Account/Login" class="btn btn-sky-secondary">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Log In
                        </a>
                    }
                </div>
            </div>

            <!-- Glowing Right Glass Card -->
            <div class="col-lg-5">
                <div class="sky-glass-card p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(0, 119, 182, 0.15); color: #0077b6; border: 1px solid #0077b6;">
                            <i class="bi bi-hospital fs-1"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">3eyadty Services</h3>
                        <p class="text-primary fw-medium small mb-0">High performance medical ecosystem</p>
                    </div>

                    <div class="d-flex align-items-center mb-3 p-3 rounded-4" style="background: rgba(255, 255, 255, 0.6); border: 1px solid rgba(255, 255, 255, 0.9);">
                        <i class="bi bi-check-circle-fill text-primary fs-3 me-3"></i>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">Instant Scheduling</h6>
                            <small class="text-muted">Real-time slot reservation</small>
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-3 p-3 rounded-4" style="background: rgba(255, 255, 255, 0.6); border: 1px solid rgba(255, 255, 255, 0.9);">
                        <i class="bi bi-check-circle-fill text-primary fs-3 me-3"></i>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">Top Doctors</h6>
                            <small class="text-muted">Certified medical experts</small>
                        </div>
                    </div>

                    <div class="d-flex align-items-center p-3 rounded-4" style="background: rgba(255, 255, 255, 0.6); border: 1px solid rgba(255, 255, 255, 0.9);">
                        <i class="bi bi-check-circle-fill text-primary fs-3 me-3"></i>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">E-Prescriptions</h6>
                            <small class="text-muted">Access medical records instantly</small>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Features Section -->
<div class="container py-4 mb-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-dark mb-2">Built For Fast Healthcare</h2>
        <p class="text-primary fw-medium">Modern tools tailored for patients and clinic staff.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="sky-glass-card p-4 h-100 text-center">
                <div class="sky-icon-box mx-auto mb-3">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Ultra Fast</h5>
                <p class="text-muted small mb-0">Book your appointments and get confirmation in seconds.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="sky-glass-card p-4 h-100 text-center">
                <div class="sky-icon-box mx-auto mb-3" style="background: linear-gradient(135deg, #00b4d8 0%, #0077b6 100%);">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Highly Secure</h5>
                <p class="text-muted small mb-0">Your confidential medical records are completely encrypted.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="sky-glass-card p-4 h-100 text-center">
                <div class="sky-icon-box mx-auto mb-3">
                    <i class="bi bi-grid-1x2-fill"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Role Dashboards</h5>
                <p class="text-muted small mb-0">Customized experiences for Admin, Doctor, and Patient roles.</p>
            </div>
        </div>
    </div>
</div>